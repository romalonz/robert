{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Robert",
  "version": "0.1.9",
  "identifier": "com.robertapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Robert",
        "width": 720,
        "height": 54,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "contentProtected": true,
        "focus": false,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app"],
    "externalBin": ["binaries/robert-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["info.plist", "pluely.desktop", "resources/models/**/*"],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:pluely.db"]
    },
    "updater": {
      "endpoints": ["https://github.com/romalonzo/robert-app/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5OEU1RUQ0QTFGNTI0OUIKUldTYkpQV2gxRjZPcVNhQkwreG0yYUZ0eERhdkFWTWJIQ2wrMGUvYUFMbWIzbzJpTjFVVWtFalUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
